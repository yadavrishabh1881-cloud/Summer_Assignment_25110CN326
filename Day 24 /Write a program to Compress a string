#include <stdio.h>

int main()
{
    char str[100], compressed[100];
    int i, j = 0, n, count;

    printf("Enter a string: ");
    scanf("%s", str);

    for (n = 0; str[n] != '\0'; n++)
        ;

    i = 0;

    while (i < n)
    {
        count = 1;

        while (i + 1 < n && str[i] == str[i + 1])
        {
            count++;
            i++;
        }

        compressed[j] = str[i];
        j++;
        if (count > 1)
        {
            char numStr[10];
            int k = 0, temp = count;

            while (temp != 0)
            {
                numStr[k] = (temp % 10) + '0';
                k++;
                temp = temp / 10;
            }
            while (k > 0)
            {
                k--;
                compressed[j] = numStr[k];
                j++;
            }
        }

        i++;
    }

    compressed[j] = '\0';

    printf("Compressed string = %s\n", compressed);

    return 0;
}
