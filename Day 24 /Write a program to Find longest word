#include <stdio.h>

int main()
{
    char str[200];
    char longest[100];
    char current[100];
    int i, j = 0, k = 0;

    printf("Enter a sentence: ");
    fgets(str, 200, stdin);

    longest[0] = '\0';
    current[0] = '\0';

    for (i = 0; str[i] != '\0'; i++)
    {
        if (str[i] != ' ' && str[i] != '\n')
        {
            current[j] = str[i];
            j++;
        }
        else
        {
            current[j] = '\0';
            int lenCurrent = 0, lenLongest = 0;

            for (k = 0; current[k] != '\0'; k++)
                lenCurrent++;

            for (k = 0; longest[k] != '\0'; k++)
                lenLongest++;

            if (lenCurrent > lenLongest)
            {
                for (k = 0; k <= lenCurrent; k++)
                {
                    longest[k] = current[k];
                }
            }

            j = 0;
        }
    }

    printf("Longest word is: %s\n", longest);

    return 0;
}
