#include <stdio.h>

int main()
{
    char str[100], result[100];
    int i, j, k, n, isDuplicate;

    printf("Enter a string: ");
    scanf("%s", str);

    for (n = 0; str[n] != '\0'; n++)
        ;

    k = 0;

    for (i = 0; i < n; i++)
    {
        isDuplicate = 0;

        for (j = 0; j < k; j++)
        {
            if (str[i] == result[j])
            {
                isDuplicate = 1;
                break;
            }
        }

        if (isDuplicate == 0)
        {
            result[k] = str[i];
            k++;
        }
    }

    result[k] = '\0';

    printf("String after removing duplicates = %s\n", result);

    return 0;
}
