#include <stdio.h>

int main()
{
    char str1[100], str2[100], rotated[100];
    int i, j, n1, n2, match;

    printf("Enter first string: ");
    scanf("%s", str1);

    printf("Enter second string: ");
    scanf("%s", str2);

    for (n1 = 0; str1[n1] != '\0'; n1++)
        ;

    for (n2 = 0; str2[n2] != '\0'; n2++)
        ;

    if (n1 != n2)
    {
        printf("Not a rotation (different lengths)\n");
        return 0;
    }

    for (i = 0; i < n1; i++)
    {
        for (j = 0; j < n1; j++)
        {
            rotated[j] = str1[(j + i) % n1];
        }
        rotated[n1] = '\0';
        match = 1;
        for (j = 0; j < n1; j++)
        {
            if (rotated[j] != str2[j])
            {
                match = 0;
                break;
            }
        }

        if (match == 1)
        {
            printf("%s is a rotation of %s\n", str2, str1);
            return 0;
        }
    }

    printf("%s is not a rotation of %s\n", str2, str1);

    return 0;
}
