#include <stdio.h>

int main()
{
    char str[100];
    int i, n;
    int count[26] = {0};
    int max_count, max_index;

    printf("Enter a string: ");
    scanf("%s", str);

    for (n = 0; str[n] != '\0'; n++)
        ;

    for (i = 0; i < n; i++)
    {
        count[str[i] - 'a']++;
    }

    max_count = count[0];
    max_index = 0;

    for (i = 1; i < 26; i++)
    {
        if (count[i] > max_count)
        {
            max_count = count[i];
            max_index = i;
        }
    }

    printf("Maximum occurring character is '%c'\n", max_index + 'a');
    printf("It occurs %d times\n", max_count);

    return 0;
}
