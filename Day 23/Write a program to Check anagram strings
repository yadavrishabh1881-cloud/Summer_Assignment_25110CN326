
#include <stdio.h>

int main()
{
    char str1[100], str2[100];
    int i, len1 = 0, len2 = 0;
    int count[26] = {0};
    int flag = 0;

    printf("Enter first string: ");
    scanf("%s", str1);

    printf("Enter second string: ");
    scanf("%s", str2);

    for (i = 0; str1[i] != '\0'; i++)
        len1++;

    for (i = 0; str2[i] != '\0'; i++)
        len2++;

    if (len1 != len2)
    {
        printf("Not anagrams (different lengths)\n");
        return 0;
    }

    for (i = 0; i < len1; i++)
    {
        count[str1[i] - 'a']++;
    }

    for (i = 0; i < len2; i++)
    {
        count[str2[i] - 'a']--;
    }

    for (i = 0; i < 26; i++)
    {
        if (count[i] != 0)
        {
            flag = 1;
            break;
        }
    }

    if (flag == 0)
        printf("%s and %s are anagrams\n", str1, str2);
    else
        printf("%s and %s are not anagrams\n", str1, str2);

    return 0;
}
