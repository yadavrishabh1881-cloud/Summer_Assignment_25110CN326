#include <stdio.h>

int main()
{
    char str[100];
    int i, j, n, count;
    int found = 0;

    printf("Enter a string: ");
    scanf("%s", str);

    for (n = 0; str[n] != '\0'; n++)
        ;

    for (i = 0; i < n; i++)
    {
        count = 0;

        for (j = 0; j < n; j++)
        {
            if (str[i] == str[j])
            {
                count++;
            }
        }

        if (count > 1)
        {
            printf("First repeating character is '%c'\n", str[i]);
            found = 1;
            break;
        }
    }

    if (found == 0)
    {
        printf("No repeating character found\n");
    }

    return 0;
}
