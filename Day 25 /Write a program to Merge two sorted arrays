#include <stdio.h>

int main()
{
    int a[50], b[50], merged[100];
    int n1, n2, i, j, k;

    printf("Enter number of elements in first array: ");
    scanf("%d", &n1);

    printf("Enter %d elements (in sorted order):\n", n1);
    for (i = 0; i < n1; i++)
    {
        scanf("%d", &a[i]);
    }

    printf("Enter number of elements in second array: ");
    scanf("%d", &n2);

    printf("Enter %d elements (in sorted order):\n", n2);
    for (i = 0; i < n2; i++)
    {
        scanf("%d", &b[i]);
    }

    i = 0;
    j = 0;
    k = 0;

    while (i < n1 && j < n2)
    {
        if (a[i] <= b[j])
        {
            merged[k] = a[i];
            i++;
        }
        else
        {
            merged[k] = b[j];
            j++;
        }
        k++;
    }

    while (i < n1)
    {
        merged[k] = a[i];
        i++;
        k++;
    }

    while (j < n2)
    {
        merged[k] = b[j];
        j++;
        k++;
    }

    printf("Merged sorted array:\n");
    for (i = 0; i < k; i++)
    {
        printf("%d ", merged[i]);
    }
    printf("\n");

    return 0;
}
