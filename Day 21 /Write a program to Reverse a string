#include <stdio.h>

int main()
{
    char str[100];
    int i, length = 0, j;
    char temp;

    printf("Enter a string: ");
    scanf("%s", str);
    for (i = 0; str[i] != '\0'; i++)
    {
        length++;
    }

    i = 0;
    j = length - 1;

    while (i < j)
    {
        temp = str[i];
        str[i] = str[j];
        str[j] = temp;
        i++;
        j--;
    }

    printf("Reversed string = %s\n", str);

    return 0;
}
