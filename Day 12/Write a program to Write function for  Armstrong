#include <stdio.h>

int main()
{
    int n, original, remainder, result = 0, digits = 0, temp;

    printf("Enter a number: ");
    scanf("%d", &n);

    original = n;
    temp = n;
    while (temp != 0)
    {
        temp = temp / 10;
        digits++;
    }

    temp = original;

    while (temp != 0)
    {
        remainder = temp % 10;
        int power = 1;
        int i;
        for (i = 1; i <= digits; i++)
        {
            power = power * remainder;
        }

        result = result + power;
        temp = temp / 10;
    }

    if (result == original)
        printf("%d is an Armstrong number\n", original);
    else
        printf("%d is not an Armstrong number\n", original);

    return 0;
}
