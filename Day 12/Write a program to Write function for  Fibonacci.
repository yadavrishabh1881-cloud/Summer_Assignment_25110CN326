#include <stdio.h>

int main()
{
    int num, i, first = 0, second = 1, next;

    printf("Enter how many terms you want: ");
    scanf("%d", &num);

    printf("Fibonacci Series: ");

    for (i = 1; i <= num; i++)
    {
        if (i == 1)
        {
            printf("%d ", first);
            continue;
        }
        if (i == 2)
        {
            printf("%d ", second);
            continue;
        }

        next = first + second;
        printf("%d ", next);

        first = second;
        second = next;
    }

    printf("\n");

    return 0;
}
