#include <stdio.h>

int main() {
    int a , b ,c , rev=0 ;
    printf("Enter the Number :");
    scanf("%d",&a);
    c = a ;
    while ( a>0)
    { b= a%10;
      rev = rev*10 + b ;
      a = a/10 ; }
      if ( rev == c){
          printf("The number is palindrome");
      }
      else {
          printf("The Number is not palindrome ");
      }
    return 0;
}
